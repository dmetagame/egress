# Isolated execution-tooling reference. Do not source this file wholesale.
# Provision the deployment-only and worker-only sections into separate secret
# environments, and never load either into web, observation, or alerting.
EGRESS_EXECUTION_ENVIRONMENT=DISABLED
EGRESS_EXECUTION_SUBMISSION_ENABLED=false
EGRESS_EXECUTION_RPC_URL=
EGRESS_EXECUTION_CHAIN_ID=
EGRESS_EXECUTION_EGRESS_CONTRACT=
EGRESS_EXECUTION_KEEPER_ADDRESS=
EGRESS_EXECUTION_ANCHOR_BLOCK=
EGRESS_EXECUTION_ANCHOR_BLOCK_HASH=
EGRESS_EXECUTION_FORK_RUNTIME=
EGRESS_EXECUTION_ENVIRONMENT_ID=
EGRESS_EXECUTION_CREDENTIAL_REFERENCE=
EGRESS_EXECUTION_TESTNET_MANIFEST_PATH=
EGRESS_EXECUTION_TESTNET_MANIFEST_HASH=
EGRESS_EXECUTION_MAX_SNAPSHOT_AGE_SECONDS=300
EGRESS_EXECUTION_MAX_INTENT_AGE_SECONDS=300

# Shared durable evidence store. Required whenever the worker is enabled.
# In production this URL must use a worker-specific least-privilege role: read
# canonical snapshots/migrations, append/read staging tables, and no writes to
# observation, alert, or OKX source-revision history.
EGRESS_DATABASE_URL=

# Explicit protocol address book. FORK_WRITE defaults to the verified X Layer
# mainnet configuration; TESTNET_WRITE requires every value below.
EGRESS_EXECUTION_ADDRESSES_PROVIDER=
EGRESS_EXECUTION_AAVE_POOL=
EGRESS_EXECUTION_AAVE_ORACLE=
EGRESS_EXECUTION_XBETH=
EGRESS_EXECUTION_XETH=
EGRESS_EXECUTION_A_XBETH=
EGRESS_EXECUTION_VARIABLE_DEBT_XETH=
EGRESS_EXECUTION_UNISWAP_FACTORY=
EGRESS_EXECUTION_SWAP_ROUTER=
EGRESS_EXECUTION_QUOTER_V2=
EGRESS_EXECUTION_SWAP_POOL=
EGRESS_EXECUTION_POOL_FEE=

# Worker-only credential. Required only when submission is explicitly enabled.
# Never prefix this variable with NEXT_PUBLIC_ and never place it in web envs.
EGRESS_EXECUTION_PRIVATE_KEY=

# Phase 10 pinned-fork E2E only. The archive URL uses a separate role that can
# append the deterministic fork snapshot. EGRESS_DATABASE_URL remains the
# least-privilege execution-worker role. Both must target the same dedicated
# database and migrations 0001-0004 must already be applied.
EGRESS_XLAYER_FORK_RPC_URL=
EGRESS_PHASE10_ARCHIVE_DATABASE_URL=

# TESTNET_WRITE requires all four testnet fields above, a dedicated
# chain-1952 RPC, a manifest whose deployment block/hash is the execution
# anchor, and a separately provisioned worker credential. The credential
# reference is metadata only; the private key remains in the isolated worker
# secret store and is never part of this manifest or any evidence record.
EGRESS_PHASE11_ARCHIVE_DATABASE_URL=

# Phase 11 compatibility deployment only. The deployment step uses the
# borrower key to register the exact manifest-pinned policy. Keep the deployer
# key out of the execution worker afterward. The controlled E2E proof uses the
# borrower and risk-attestor keys only to reproduce signed deterministic
# evidence; none belongs in observation or web runtimes.
EGRESS_PHASE11_DEPLOYER_PRIVATE_KEY=
EGRESS_PHASE11_BORROWER_PRIVATE_KEY=
EGRESS_PHASE11_RISK_ATTESTOR_PRIVATE_KEY=
EGRESS_PHASE11_BORROWER_ADDRESS=
EGRESS_PHASE11_RISK_ATTESTOR_ADDRESS=
EGRESS_PHASE11_COMPATIBILITY_LABEL='Egress Phase 11 compatibility deployment v1'
EGRESS_PHASE11_MANIFEST_PATH=deployments/phase11/xlayer-testnet.json
# Exact deployer pending nonce observed immediately before deployment. The
# script refuses to adopt a different nonce automatically.
EGRESS_PHASE11_STARTING_NONCE=
# Optional. Defaults to <EGRESS_PHASE11_MANIFEST_PATH>.journal.json and must
# resolve to a different file from the final manifest.
EGRESS_PHASE11_JOURNAL_PATH=
EGRESS_PHASE11_EXECUTION_BOUNDS_JSON='{"minimumRiskLevel":3,"maxRepaymentPerExecution":"12000000000000000000","maxCollateralPerExecution":"12000000000000000000","maxCumulativeRepayment":"12000000000000000000","maxCumulativeCollateral":"12500000000000000000","maxCollateralPercentageBps":"2500","maxPositionDebt":"46000000000000000000","maxSlippageBps":"100","maxOracleDeviationBps":"125","maxFlashLoanPremiumBps":"5","maxPreHealthFactor":"1050000000000000000","minPostHealthFactor":"1065000000000000000","minCooldownSeconds":"0","maxExecutions":"1","maxRiskAgeSeconds":"86400","maxClockSkewSeconds":"60"}'
