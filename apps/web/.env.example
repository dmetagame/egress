# Production observation runtime. LIVE_READ_ONLY is the only accepted mode.
EGRESS_RUNTIME_MODE=LIVE_READ_ONLY
EGRESS_DEPLOYMENT_ENV=
EGRESS_LIVE_MAINNET_BROADCAST=false
LIVE_MAINNET_BROADCAST=false

# Live read-only adapters. Leave EGRESS_LIVE_ACCOUNT empty until a supported
# public Aave position is intentionally selected for observation.
EGRESS_XLAYER_RPC_URL=https://rpc.xlayer.tech
# Optional comma-separated read-only fallbacks. Every provider is chain-checked
# and tried in order; credentials must stay server-side.
EGRESS_XLAYER_RPC_URLS=
EGRESS_LIVE_ACCOUNT=
EGRESS_LIVE_EGRESS_SPENDER=
# Optional audit pin. The hash is accepted only with its exact block number.
EGRESS_LIVE_OBSERVATION_BLOCK=
EGRESS_LIVE_OBSERVATION_BLOCK_HASH=
EGRESS_LIVE_MAX_BLOCK_AGE_SECONDS=120
EGRESS_LIVE_MAX_ORACLE_AGE_SECONDS=21600
EGRESS_LIVE_MAX_SOURCE_AGE_SECONDS=86400

# A local/server-side revision store. Never expose this path to the browser.
EGRESS_RISK_STORE_PATH=
EGRESS_LIVE_ARCHIVE_PATH=
# Required on Vercel and when EGRESS_DEPLOYMENT_ENV=production.
EGRESS_DATABASE_URL=
# Hosted web/API must read PostgreSQL only. Keep false on Vercel; the persistent
# poller process owns all observation writes.
EGRESS_WEB_INLINE_POLLING=false

# Poller reliability. Polling below 60 seconds is rejected.
EGRESS_LIVE_POLL_INTERVAL_SECONDS=300
EGRESS_LIVE_POLL_READ_TIMEOUT_MS=120000
EGRESS_LIVE_POLL_ARCHIVE_TIMEOUT_MS=30000
EGRESS_LIVE_POLL_MAX_ATTEMPTS=2
EGRESS_LIVE_POLL_RETRY_BACKOFF_MS=500
EGRESS_LIVE_POLL_MAX_RETRY_BACKOFF_MS=5000
EGRESS_LIVE_POLL_FAILURE_THRESHOLD=3

# Alert delivery. Webhook URL and secret must be configured together. Keep all
# alert credentials server-only and leave the secret blank in source control.
EGRESS_ALERT_CONSOLE_ENABLED=true
EGRESS_ALERT_WEBHOOK_URL=
EGRESS_ALERT_WEBHOOK_SECRET=
EGRESS_ALERT_WEBHOOK_SINK_ID=
EGRESS_ALERT_DELIVERY_TIMEOUT_MS=10000
EGRESS_ALERT_MAX_ATTEMPTS_PER_RUN=3
EGRESS_ALERT_MAX_TOTAL_ATTEMPTS=6
EGRESS_ALERT_RETRY_BACKOFF_MS=1000
EGRESS_ALERT_MAX_RETRY_BACKOFF_MS=60000
EGRESS_ALERT_DELIVERY_LEASE_MS=120000

# Read-only visibility into the isolated Phase 9 staging worker. These values
# describe the worker but do not provide credentials or a browser write path.
# Never configure EGRESS_EXECUTION_PRIVATE_KEY in the web/observation runtime.
EGRESS_EXECUTION_ENVIRONMENT=DISABLED
EGRESS_EXECUTION_SUBMISSION_ENABLED=false
EGRESS_EXECUTION_RPC_URL=
EGRESS_EXECUTION_CHAIN_ID=
EGRESS_EXECUTION_EGRESS_CONTRACT=
EGRESS_EXECUTION_KEEPER_ADDRESS=
EGRESS_EXECUTION_ANCHOR_BLOCK=
EGRESS_EXECUTION_ANCHOR_BLOCK_HASH=
EGRESS_EXECUTION_FORK_RUNTIME=
EGRESS_EXECUTION_MAX_SNAPSHOT_AGE_SECONDS=300
EGRESS_EXECUTION_MAX_INTENT_AGE_SECONDS=300
EGRESS_EXECUTION_ADDRESSES_PROVIDER=
EGRESS_EXECUTION_AAVE_POOL=
EGRESS_EXECUTION_AAVE_ORACLE=
EGRESS_EXECUTION_XBETH=
EGRESS_EXECUTION_XETH=
EGRESS_EXECUTION_A_XBETH=
EGRESS_EXECUTION_VARIABLE_DEBT_XETH=
EGRESS_EXECUTION_UNISWAP_FACTORY=
EGRESS_EXECUTION_SWAP_ROUTER=
EGRESS_EXECUTION_QUOTER_V2=
EGRESS_EXECUTION_SWAP_POOL=
EGRESS_EXECUTION_POOL_FEE=

# Fork-only wallet UI writes. This never enables live-mainnet broadcasting.
NEXT_PUBLIC_EGRESS_ENABLE_FORK_WRITES=false
